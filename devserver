#!/bin/bash

# =============================================================================
# 🚀 SERVIDOR DE DESARROLLO - SCRIPT PRINCIPAL
# =============================================================================
# Gestión completa del servidor de desarrollo Ubuntu
# Autor: Reserved Technology
# Versión: 2.0
# =============================================================================

# Configuración
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="/home/oscar/Documentos/reserved-ml"
SERVER_IP="192.168.1.140"
VERSION="2.0"

# Colores para output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# Función para mostrar mensajes con colores
log_info() { echo -e "${BLUE}ℹ️  $1${NC}"; }
log_success() { echo -e "${GREEN}✅ $1${NC}"; }
log_warning() { echo -e "${YELLOW}⚠️  $1${NC}"; }
log_error() { echo -e "${RED}❌ $1${NC}"; }
log_header() { echo -e "${PURPLE}🚀 $1${NC}"; }

show_banner() {
    echo -e "${CYAN}"
    cat << 'EOF'
╔══════════════════════════════════════════════════════════════╗
║                🚀 SERVIDOR DE DESARROLLO UBUNTU               ║
║                    Reserved Technology                       ║
╚══════════════════════════════════════════════════════════════╝
EOF
    echo -e "${NC}"
    echo -e "${BLUE}Versión: $VERSION | IP: $SERVER_IP${NC}"
    echo ""
}

show_help() {
    show_banner
    
    echo "📋 COMANDOS DISPONIBLES:"
    echo ""
    echo -e "${YELLOW}🔧 GESTIÓN DEL SERVIDOR:${NC}"
    echo "  status                - Estado completo del servidor"
    echo "  start                 - Iniciar todos los servicios"
    echo "  restart               - Reiniciar servicios principales"
    echo ""
    echo -e "${YELLOW}📦 GESTIÓN DE PROYECTOS:${NC}"
    echo "  projects              - Listar todos los proyectos"
    echo "  project start [name]  - Iniciar proyecto específico"
    echo "  project stop [name]   - Detener proyecto específico"
    echo "  project status [name] - Ver estado de proyecto"
    echo ""
    echo -e "${YELLOW}➕ NUEVOS PROYECTOS:${NC}"
    echo "  new [template] [name] - Crear proyecto desde template"
    echo "  clone [url] [name]    - Clonar proyecto desde Git"
    echo "  templates             - Ver templates disponibles"
    echo ""
    echo -e "${YELLOW}🖥️  HERRAMIENTAS:${NC}"
    echo "  vscode                - Gestionar VS Code Server"
    echo "  logs                  - Ver logs del sistema"
    echo "  update                - Actualizar servidor y dependencias"
    echo ""
    echo -e "${YELLOW}📚 INFORMACIÓN:${NC}"
    echo "  info                  - Información del servidor"
    echo "  docs                  - Abrir documentación"
    echo ""
    echo "EJEMPLOS:"
    echo "  $0 new nextjs MiEcommerce"
    echo "  $0 project start TacoManager"
    echo "  $0 clone https://github.com/usuario/repo.git MiRepo"
}

check_dependencies() {
    log_info "Verificando dependencias..."
    
    local missing=()
    
    # Verificar comandos esenciales
    command -v git >/dev/null 2>&1 || missing+=("git")
    command -v node >/dev/null 2>&1 || missing+=("nodejs")
    command -v npm >/dev/null 2>&1 || missing+=("npm")
    
    if [ ${#missing[@]} -ne 0 ]; then
        log_error "Dependencias faltantes: ${missing[*]}"
        log_info "Ejecuta: sudo apt install ${missing[*]}"
        return 1
    fi
    
    log_success "Todas las dependencias están instaladas"
    return 0
}

server_status() {
    show_banner
    log_header "ESTADO DEL SERVIDOR"
    
    echo "🌐 IP del servidor: $SERVER_IP"
    echo "📁 Directorio base: $PROJECT_DIR"
    echo "📄 Versión: $VERSION"
    echo ""
    
    echo "🔧 SERVICIOS:"
    systemctl is-active ssh >/dev/null && echo "  ✅ SSH (Puerto 22)" || echo "  ❌ SSH"
    systemctl is-active apache2 >/dev/null && echo "  ✅ Apache2 (Puerto 80)" || echo "  ❌ Apache2"
    
    echo ""
    echo "🐳 DOCKER:"
    if command -v docker >/dev/null 2>&1; then
        sudo docker ps --format "  ✅ {{.Names}} - {{.Status}}" 2>/dev/null || echo "  ❌ Sin contenedores"
    else
        echo "  ❌ Docker no instalado"
    fi
    
    echo ""
    echo "🚀 PROYECTOS ACTIVOS:"
    if pgrep -f "(next|vite|npm|pnpm).*dev" >/dev/null; then
        ps aux | grep -E "(next|vite|npm|pnpm).*dev" | grep -v grep | awk '{print "  🟢 " $11 " " $12 " " $13}'
    else
        echo "  📋 No hay proyectos en desarrollo activos"
    fi
    
    echo ""
    echo "🔌 PUERTOS EN USO:"
    sudo netstat -tlnp | grep -E ":(22|80|3000|3001|5173|8000|8080|8081)" | head -8 | while read line; do
        port=$(echo $line | awk '{print $4}' | cut -d: -f2)
        echo "  🔗 Puerto $port"
    done
}

start_server() {
    log_header "INICIANDO SERVIDOR DE DESARROLLO"
    
    log_info "Verificando servicios básicos..."
    
    # SSH
    sudo systemctl start ssh
    sudo systemctl enable ssh
    log_success "SSH habilitado"
    
    # Apache
    sudo systemctl start apache2
    sudo systemctl enable apache2
    log_success "Apache2 habilitado"
    
    # Crear enlace simbólico si no existe
    if [ ! -L "/var/www/html/projects" ]; then
        sudo ln -sf "$PROJECT_DIR" /var/www/html/projects
        log_success "Enlace de proyectos creado"
    fi
    
    # Establecer permisos
    sudo chown -R oscar:www-data "$PROJECT_DIR" 2>/dev/null || true
    sudo chmod -R 755 "$PROJECT_DIR" 2>/dev/null || true
    
    log_success "Servidor iniciado correctamente"
    echo ""
    echo "🌐 Accesos disponibles:"
    echo "  SSH: ssh oscar@$SERVER_IP"
    echo "  Web: http://$SERVER_IP"
    echo "  Proyectos: http://$SERVER_IP/projects"
}

list_projects() {
    log_header "PROYECTOS DISPONIBLES"
    
    local count=0
    for dir in "$PROJECT_DIR"/*; do
        if [ -d "$dir" ] && [ "$(basename "$dir")" != "scripts" ] && [ "$(basename "$dir")" != "templates" ] && [ "$(basename "$dir")" != "docs" ] && [ "$(basename "$dir")" != "config" ]; then
            project_name=$(basename "$dir")
            count=$((count + 1))
            
            echo "📁 $project_name"
            
            # Detectar tipo
            if [ -f "$dir/package.json" ]; then
                if grep -q "next" "$dir/package.json" 2>/dev/null; then
                    echo "   🔸 Next.js Project"
                elif grep -q "vite" "$dir/package.json" 2>/dev/null; then
                    echo "   🔸 Vite Project"
                else
                    echo "   🔸 Node.js Project"
                fi
            elif [ -f "$dir/requirements.txt" ] || [ -f "$dir/setup.py" ]; then
                echo "   🔸 Python Project"
            else
                echo "   🔸 General Project"
            fi
            
            echo "   🌐 http://$SERVER_IP/projects/$project_name"
            
            # Estado
            if pgrep -f "$project_name.*dev" >/dev/null 2>&1; then
                echo "   🟢 Estado: CORRIENDO"
            else
                echo "   🔴 Estado: DETENIDO"
            fi
            echo ""
        fi
    done
    
    if [ $count -eq 0 ]; then
        log_warning "No hay proyectos disponibles"
        echo "Crea uno nuevo con: $0 new [template] [nombre]"
    fi
}

project_command() {
    local action=$1
    local project_name=$2
    
    case "$action" in
        start)
            if [ -z "$project_name" ]; then
                log_error "Especifica un proyecto: $0 project start [nombre]"
                return 1
            fi
            "$SCRIPT_DIR/scripts/project-manager.sh" start "$project_name"
            ;;
        stop)
            if [ -z "$project_name" ]; then
                "$SCRIPT_DIR/scripts/project-manager.sh" stop all
            else
                "$SCRIPT_DIR/scripts/project-manager.sh" stop "$project_name"
            fi
            ;;
        status)
            if [ -z "$project_name" ]; then
                "$SCRIPT_DIR/scripts/project-manager.sh" ps
            else
                "$SCRIPT_DIR/scripts/add-project.sh" status "$project_name"
            fi
            ;;
        *)
            log_error "Acción no válida: $action"
            echo "Acciones válidas: start, stop, status"
            ;;
    esac
}

new_project() {
    local template=$1
    local project_name=$2
    
    if [ -z "$template" ] || [ -z "$project_name" ]; then
        log_error "Uso: $0 new [template] [nombre]"
        echo "Ver templates: $0 templates"
        return 1
    fi
    
    "$SCRIPT_DIR/scripts/add-project.sh" template "$template" "$project_name"
}

clone_project() {
    local repo_url=$1
    local project_name=$2
    
    if [ -z "$repo_url" ] || [ -z "$project_name" ]; then
        log_error "Uso: $0 clone [url] [nombre]"
        return 1
    fi
    
    "$SCRIPT_DIR/scripts/add-project.sh" clone "$repo_url" "$project_name"
}

show_templates() {
    "$SCRIPT_DIR/scripts/add-project.sh" list-templates
}

vscode_command() {
    "$SCRIPT_DIR/scripts/vscode-server.sh" "$@"
}

show_info() {
    show_banner
    
    echo "📋 INFORMACIÓN DEL SISTEMA:"
    echo "  🖥️  SO: $(lsb_release -d | cut -f2)"
    echo "  🔧 Kernel: $(uname -r)"
    echo "  💾 RAM: $(free -h | awk '/^Mem:/ {print $3 "/" $2}')"
    echo "  💿 Disco: $(df -h / | awk 'NR==2 {print $3 "/" $2 " (" $5 " usado)"}')"
    echo ""
    echo "📦 HERRAMIENTAS INSTALADAS:"
    command -v node >/dev/null && echo "  ✅ Node.js $(node --version)" || echo "  ❌ Node.js"
    command -v npm >/dev/null && echo "  ✅ npm $(npm --version)" || echo "  ❌ npm"
    command -v pnpm >/dev/null && echo "  ✅ pnpm $(pnpm --version)" || echo "  ❌ pnpm"
    command -v git >/dev/null && echo "  ✅ Git $(git --version | cut -d' ' -f3)" || echo "  ❌ Git"
    command -v docker >/dev/null && echo "  ✅ Docker $(docker --version | cut -d' ' -f3 | tr -d ',')" || echo "  ❌ Docker"
    echo ""
    echo "🌐 ACCESOS:"
    echo "  SSH: ssh oscar@$SERVER_IP"
    echo "  Web: http://$SERVER_IP"
    echo "  Proyectos: http://$SERVER_IP/projects"
    echo "  VS Code: http://$SERVER_IP:8081"
}

show_logs() {
    echo "📋 Logs del sistema (últimas 20 líneas):"
    sudo journalctl -n 20 --no-pager
}

update_system() {
    log_header "ACTUALIZANDO SISTEMA"
    
    log_info "Actualizando paquetes del sistema..."
    sudo apt update && sudo apt upgrade -y
    
    log_info "Actualizando npm global..."
    sudo npm update -g
    
    log_success "Sistema actualizado"
}

open_docs() {
    if [ -f "$SCRIPT_DIR/docs/README-SERVIDOR-DEV.md" ]; then
        cat "$SCRIPT_DIR/docs/README-SERVIDOR-DEV.md"
    else
        log_error "Documentación no encontrada"
    fi
}

# Comando principal
case "$1" in
    status|st)
        server_status
        ;;
    start)
        start_server
        ;;
    restart)
        log_info "Reiniciando servicios..."
        sudo systemctl restart ssh apache2
        log_success "Servicios reiniciados"
        ;;
    projects|ls)
        list_projects
        ;;
    project)
        project_command "$2" "$3"
        ;;
    new)
        new_project "$2" "$3"
        ;;
    clone)
        clone_project "$2" "$3"
        ;;
    templates)
        show_templates
        ;;
    vscode)
        shift
        vscode_command "$@"
        ;;
    info)
        show_info
        ;;
    logs)
        show_logs
        ;;
    update)
        update_system
        ;;
    docs)
        open_docs
        ;;
    *)
        show_help
        ;;
esac
