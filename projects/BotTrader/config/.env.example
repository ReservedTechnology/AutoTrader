# BotTrader Configuration - Dual Database Architecture
# Copy this file to config/.env and fill in your actual values

# === DATABASE - DUAL ARCHITECTURE ===

# TimescaleDB (Railway) - For time-series data
TIMESCALE_URL=your_timescale_url_here
TIMESCALE_HOST=your_timescale_host_here
TIMESCALE_PORT=5432
TIMESCALE_DB=bottrader_timeseries
TIMESCALE_USER=postgres
TIMESCALE_PASSWORD=your_timescale_password_here

# Supabase - For non-temporal data
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_key_here

# === FOREX APIS ===

# OANDA v20 API Configuration
OANDA_API_KEY=your_oanda_api_key_here
OANDA_ACCOUNT_ID=your_oanda_account_id_here
OANDA_ENVIRONMENT=practice  # practice or live

# Alpha Vantage API
ALPHA_VANTAGE_KEY=your_alpha_vantage_key_here

# TraderMade API
TRADERMADE_KEY=your_tradermade_key_here

# === NEWS AND SENTIMENT APIS ===

# Twitter/X API v2
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# Reddit API
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=BotTrader/1.0

# === DEPLOYMENT ===

# Railway Configuration
RAILWAY_PROJECT_ID=your_railway_project_id_here
RAILWAY_API_TOKEN=your_railway_api_token_here
RAILWAY_ENVIRONMENT=development

# === ENVIRONMENT ===
ENVIRONMENT=development  # development, staging, production
LOG_LEVEL=INFO

# === CACHING ===
REDIS_URL=redis://localhost:6379/0

# === TRADING PARAMETERS ===
TRADING_MODE=paper
MAX_POSITIONS=5
RISK_PER_TRADE=0.02
PORTFOLIO_HEAT_MAX=0.05