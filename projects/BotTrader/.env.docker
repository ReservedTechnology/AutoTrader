# Docker Environment Variables for BotTrader
# Dual Database Architecture: TimescaleDB (Docker) + Supabase (Cloud)

# === ENVIRONMENT ===
ENVIRONMENT=docker
LOG_LEVEL=DEBUG

# === DATABASE - DUAL ARCHITECTURE ===

# TimescaleDB (Docker) - For time-series data
TIMESCALE_HOST=timescaledb
TIMESCALE_PORT=5432
TIMESCALE_DB=bottrader_timeseries
TIMESCALE_USER=postgres
TIMESCALE_PASSWORD=bottrader_local_2025
TIMESCALE_URL=postgresql://postgres:bottrader_local_2025@timescaledb:5432/bottrader_timeseries

# Supabase (Cloud) - For non-temporal data
# Replace with your actual Supabase credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-key-here

# === REDIS (Docker) ===
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

# === APPLICATION ===
APP_PORT=8000
APP_HOST=0.0.0.0

# === FOREX APIS ===
OANDA_API_KEY=your-oanda-api-key
OANDA_ACCOUNT_ID=your-oanda-account-id
OANDA_ENVIRONMENT=practice

ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key
TRADERMADE_API_KEY=your-tradermade-key

# === SOCIAL MEDIA APIS ===
TWITTER_BEARER_TOKEN=your-twitter-bearer-token
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret
REDDIT_USER_AGENT=BotTrader/1.0-Docker

# === MONITORING (Docker) ===
GRAFANA_URL=http://grafana:3000
GRAFANA_API_KEY=your-grafana-api-key
PROMETHEUS_URL=http://prometheus:9090

# === NOTIFICATIONS ===
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# === TRADING PARAMETERS ===
TRADING_MODE=paper
MAX_POSITIONS=5
RISK_PER_TRADE=0.02
PORTFOLIO_HEAT_MAX=0.05

# === DATABASE CONNECTION POOLS ===
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=10000

# === PERFORMANCE SETTINGS ===
CACHE_TTL=300
BATCH_SIZE=1000
WORKER_THREADS=4

# === DOCKER SPECIFIC ===
COMPOSE_PROJECT_NAME=bottrader
DOCKER_NETWORK=bottrader_network