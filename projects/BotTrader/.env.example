# BotTrader Forex Environment Variables
# Copy this file to .env and fill in your actual values
# Dual Database Architecture: TimescaleDB (Railway) + Supabase

# === ENVIRONMENT ===
ENVIRONMENT=development  # development, staging, production
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR

# === DATABASE - DUAL ARCHITECTURE ===

# TimescaleDB (Railway) - For time-series data
# Used for: forex_prices, economic_calendar, ml_predictions, trading_signals, live_positions
TIMESCALE_HOST=your-timescale-host.railway.app
TIMESCALE_PORT=5432
TIMESCALE_DB=bottrader_timeseries
TIMESCALE_USER=postgres
TIMESCALE_PASSWORD=your-timescale-password
TIMESCALE_URL=postgresql://postgres:your-password@your-host:5432/bottrader_timeseries

# Supabase - For non-temporal data
# Used for: users, trading_strategies, closed_trades, system_config, ml_model_versions
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-key-here

# === FOREX APIS ===
# OANDA v20 API
OANDA_API_KEY=your-oanda-api-key
OANDA_ACCOUNT_ID=your-oanda-account-id
OANDA_ENVIRONMENT=practice  # practice or live

# Alpha Vantage
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key

# TraderMade
TRADERMADE_API_KEY=your-tradermade-key

# === SOCIAL MEDIA APIS (for sentiment) ===
# Twitter/X API v2
TWITTER_BEARER_TOKEN=your-twitter-bearer-token

# Reddit API
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret
REDDIT_USER_AGENT=BotTrader/1.0

# === MONITORING ===
# Grafana
GRAFANA_API_KEY=your-grafana-api-key
GRAFANA_URL=http://localhost:3000

# Prometheus
PROMETHEUS_URL=http://localhost:9090

# === NOTIFICATIONS ===
# Slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# === DEPLOYMENT (Railway) ===
RAILWAY_PROJECT_ID=your-railway-project-id
RAILWAY_API_TOKEN=your-railway-api-token
RAILWAY_ENVIRONMENT=development
RAILWAY_STATIC_URL=https://your-app.railway.app

# === REDIS (for caching and queues) ===
REDIS_URL=redis://localhost:6379/0

# === TRADING PARAMETERS ===
TRADING_MODE=paper  # paper or live
MAX_POSITIONS=5
RISK_PER_TRADE=0.02  # 2% max risk per trade
PORTFOLIO_HEAT_MAX=0.05  # 5% max portfolio exposure

# === DATABASE CONNECTION POOLS ===
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT=30000  # 30 seconds in milliseconds
DB_CONNECTION_TIMEOUT=10000  # 10 seconds in milliseconds

# === PERFORMANCE SETTINGS ===
CACHE_TTL=300  # Cache time-to-live in seconds
BATCH_SIZE=1000  # Batch size for bulk operations
WORKER_THREADS=4  # Number of worker threads