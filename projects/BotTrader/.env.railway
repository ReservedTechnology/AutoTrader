# Railway Environment Variables for BotTrader with TimescaleDB

# === DATABASE (TimescaleDB on Railway) ===
POSTGRES_DB=bottrader
POSTGRES_USER=postgres
POSTGRES_PASSWORD=${RAILWAY_POSTGRES_PASSWORD}
DATABASE_URL=postgresql://postgres:${RAILWAY_POSTGRES_PASSWORD}@timescaledb:5432/bottrader
DB_PORT=5432

# === REDIS ===
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379

# === APPLICATION ===
ENVIRONMENT=production
LOG_LEVEL=INFO
APP_PORT=8000

# === FOREX APIS ===
OANDA_API_KEY=${OANDA_API_KEY}
OANDA_ACCOUNT_ID=${OANDA_ACCOUNT_ID}
OANDA_ENVIRONMENT=practice
ALPHA_VANTAGE_API_KEY=${ALPHA_VANTAGE_API_KEY}
TRADERMADE_API_KEY=${TRADERMADE_API_KEY}

# === TRADING PARAMETERS ===
TRADING_MODE=paper
MAX_POSITIONS=5
RISK_PER_TRADE=0.02
PORTFOLIO_HEAT_MAX=0.05

# === MONITORING ===
GRAFANA_API_KEY=${GRAFANA_API_KEY}
SLACK_WEBHOOK_URL=${SLACK_WEBHOOK_URL}
TELEGRAM_BOT_TOKEN=${TELEGRAM_BOT_TOKEN}
TELEGRAM_CHAT_ID=${TELEGRAM_CHAT_ID}