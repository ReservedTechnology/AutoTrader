# Railway Environment Variables for BotTrader with Dual Database Architecture
# TimescaleDB on Railway + Supabase

# === DATABASE - DUAL ARCHITECTURE ===

# TimescaleDB (Railway) - For time-series data
POSTGRES_DB=bottrader_timeseries
POSTGRES_USER=postgres
POSTGRES_PASSWORD=${RAILWAY_POSTGRES_PASSWORD}
TIMESCALE_HOST=timescaledb
TIMESCALE_PORT=5432
TIMESCALE_DB=bottrader_timeseries
TIMESCALE_USER=postgres
TIMESCALE_PASSWORD=${RAILWAY_POSTGRES_PASSWORD}
TIMESCALE_URL=postgresql://postgres:${RAILWAY_POSTGRES_PASSWORD}@timescaledb:5432/bottrader_timeseries

# Supabase - For non-temporal data (injected from Railway variables)
SUPABASE_URL=${SUPABASE_URL}
SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY}
SUPABASE_SERVICE_KEY=${SUPABASE_SERVICE_KEY}

# === REDIS ===
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379

# === APPLICATION ===
ENVIRONMENT=production
LOG_LEVEL=INFO
APP_PORT=8000

# === FOREX APIS ===
OANDA_API_KEY=${OANDA_API_KEY}
OANDA_ACCOUNT_ID=${OANDA_ACCOUNT_ID}
OANDA_ENVIRONMENT=practice
ALPHA_VANTAGE_API_KEY=${ALPHA_VANTAGE_API_KEY}
TRADERMADE_API_KEY=${TRADERMADE_API_KEY}

# === SOCIAL MEDIA APIS ===
TWITTER_BEARER_TOKEN=${TWITTER_BEARER_TOKEN}
REDDIT_CLIENT_ID=${REDDIT_CLIENT_ID}
REDDIT_CLIENT_SECRET=${REDDIT_CLIENT_SECRET}
REDDIT_USER_AGENT=BotTrader/1.0-Railway

# === TRADING PARAMETERS ===
TRADING_MODE=paper
MAX_POSITIONS=5
RISK_PER_TRADE=0.02
PORTFOLIO_HEAT_MAX=0.05

# === MONITORING ===
GRAFANA_API_KEY=${GRAFANA_API_KEY}
GRAFANA_URL=${GRAFANA_URL}
PROMETHEUS_URL=${PROMETHEUS_URL}

# === NOTIFICATIONS ===
SLACK_WEBHOOK_URL=${SLACK_WEBHOOK_URL}
TELEGRAM_BOT_TOKEN=${TELEGRAM_BOT_TOKEN}
TELEGRAM_CHAT_ID=${TELEGRAM_CHAT_ID}

# === DATABASE CONNECTION POOLS ===
DB_POOL_MIN=5
DB_POOL_MAX=20
DB_STATEMENT_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=10000

# === PERFORMANCE SETTINGS ===
CACHE_TTL=300
BATCH_SIZE=1000
WORKER_THREADS=8